{
  "name": "nagrik-backend",
  "version": "1.0.0",
  "description": "Nagrik agentic civic complaint backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:harness": "tsx scripts/test-harness.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "eval:intake": "tsx scripts/eval-intake.ts",
    "postinstall": "playwright install chromium || true",
    "test:failures": "tsx scripts/test-failures.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:login": "tsx scripts/mcp-login.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:tracing": "tsx scripts/test-tracing.ts"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.85",
    "@ai-sdk/provider": "^4.0.19",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@supabase/supabase-js": "^2.117.2",
