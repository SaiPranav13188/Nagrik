# ───────── Nagrik backend configuration ─────────
# Everything is optional: with no keys the backend runs fully offline
# (local JSON store, rule-based agent planner, sandbox portal).

PORT=4000
# Public URL of this server (used for photo URLs and the sandbox portal). On Render: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:4000

# ── AI (Google Gemini, free key at https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_VISION_MODEL=gemini-flash-latest

# ── Supabase (leave empty to use the local JSON store in .data/) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=complaint-photos

# ── Security (CHANGE THESE in production) ──
ADMIN_API_KEY=admin-dev-key
CRON_SECRET=cron-dev-secret
LOCAL_AUTH_SECRET=dev-only-change-me

# ── Portals ──
# sandbox = auto-submit to the bundled mock portal (safe for testing)
# live    = use real government portals (Wanaparthy's needs mobile OTP → manual hand-off)
PORTAL_MODE=sandbox
SANDBOX_MATCH_ANY_CITY=true
# Non-blocking review window (seconds) before the first auto-submission to a portal
SUBMISSION_GRACE_SECONDS=15
PLAYWRIGHT_HEADLESS=true

# ── Monitoring & escalation ──
ENABLE_CRON=true
MONITOR_CRON=0 9 * * *
RECHECK_INTERVAL_HOURS=72
ESCALATION_THRESHOLD_DAYS=10

# ── Escalation email (https://resend.com) ──
RESEND_API_KEY=
ESCALATION_FROM_EMAIL=Nagrik <escalations@yourdomain.in>
# Real government inboxes are only emailed when this is true
ALLOW_LIVE_ESCALATION_EMAILS=false
# Sandbox escalations are redirected here (if set together with RESEND_API_KEY)
SANDBOX_ESCALATION_EMAIL=

NOMINATIM_USER_AGENT=Nagrik-CivicComplaints/1.0 (contact: you@example.com)
