{
  "expo": {
    "name": "Nagrik",
    "slug": "nagrik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nagrik.civic",
      "infoPlist": {
        "NSCameraUsageDescription": "Nagrik uses the camera so you can photograph civic issues to report.",
        "NSLocationWhenInUseUsageDescription": "Nagrik uses your location so the complaint reaches the right local department.",
        "NSPhotoLibraryUsageDescription": "Nagrik lets you pick a photo of the civic issue from your gallery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nagrik.civic",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Nagrik uses the camera so you can photograph civic issues to report.",
          "photosPermission": "Nagrik lets you pick a photo of the civic issue from your gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nagrik uses your location so the complaint reaches the right local department."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "scheme": "nagrik",
    "experiments": {
      "typedRoutes": true
    }
  }
}